<PreferenceScreen
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:settings="http://schemas.android.com/apk/res/com.android.settings"
    android:title="@string/themes_title">

    <!-- Launcher switch (ExpressiveOS) -->
    <PreferenceCategory
        android:key="themes_launcher_category"
        android:title="@string/launcher_switch_category">

        <org.expressiveos.settings.preferences.SystemPropertyListPreference
            android:key="persist.sys.expressiveos.launcher"
            android:title="@string/launcher_switch_title"
            android:entries="@array/launcher_switch_entries"
            android:entryValues="@array/launcher_switch_values"
            android:summary="%s"
            android:defaultValue="expressive" />

    </PreferenceCategory>

    <PreferenceCategory
        android:key="themes_fonts_category"
        android:title="@string/themes_fonts_category">

        <!-- Font style -->
        <org.expressiveos.settings.preferences.FontsPickerPreference
            android:key="system_font"
            android:title="@string/font_styles_title"
            android:summary="@string/font_styles_summary" />

        <!-- Emoji style -->
        <org.expressiveos.settings.preferences.EmojiStylePickerPreference
            android:key="persist.sys.ax_emoji_style"
            android:title="@string/emoji_style_title" />

    </PreferenceCategory>

    <PreferenceCategory
        android:key="themes_monet_colors_category"
        android:title="@string/themes_monet_colors_category">

        <!-- Monet settings -->
        <Preference
            android:key="monet_settings"
            android:title="@string/themes_monet_title"
            android:summary="@string/themes_monet_summary"
            android:fragment="org.expressiveos.settings.fragments.themes.ColorsSettingsFragment" />

        <!-- Gradient Customization -->
        <Preference
            android:key="gradient_settings"
            android:title="@string/gradient_settings_title"
            android:summary="@string/gradient_settings_summary"
            android:fragment="org.expressiveos.settings.fragments.themes.GradientSettings" />

    </PreferenceCategory>

    <PreferenceCategory
        android:key="themes_icons_category"
        android:title="@string/themes_icons_category">

        <!-- Themes -->
        <Preference
            android:key="custom_system_theme"
            android:title="@string/custom_system_theme_title"
            android:summary="@string/custom_system_theme_summary">
            <intent
                android:action="android.intent.action.MAIN"
                android:targetPackage="com.android.axion.axthemestore"
                android:targetClass="com.android.axion.axthemestore.MainActivity" />
        </Preference>

        <!-- Icon shape -->
        <Preference
            android:key="android.theme.customization.adaptive_icon_shape"
            android:title="@string/themes_icon_shape_title"
            android:fragment="org.expressiveos.settings.fragments.themes.IconShapes"/>

        <!-- Navigation bar icons -->
        <Preference
            android:key="android.theme.customization.navbar"
            android:title="@string/themes_navigation_bar_icons_title"
            android:summary="@string/themes_navigation_bar_icons_summary"
            android:fragment="org.expressiveos.settings.fragments.themes.NavigationBarIcons"/>

        <!-- Udfps icon -->
        <Preference
            android:key="udfps_icon"
            android:title="@string/themes_udfps_icon_title"
            android:summary="@string/themes_udfps_icon_summary"
            android:fragment="org.expressiveos.settings.fragments.themes.UdfpsIconPicker" />

    </PreferenceCategory>

    <PreferenceCategory
        android:key="themes_visual_effects_category"
        android:title="@string/themes_visual_effects_category">

        <!-- Boot animation -->
        <Preference
            android:key="boot_animation"
            android:title="@string/themes_boot_animation_title"
            android:fragment="org.expressiveos.settings.fragments.themes.BootAnimation"
            settings:controller="org.expressiveos.settings.fragments.themes.BootAnimationController" />

        <!-- Screen off animation -->
        <org.expressiveos.settings.preferences.SystemSettingListPreference
            android:key="screen_off_animation"
            android:title="@string/themes_screen_off_animation_title"
            android:entries="@array/themes_screen_off_animation_entries"
            android:entryValues="@array/themes_screen_off_animation_values"
            android:defaultValue="0" />

        <!-- Udfps animation -->
        <Preference
            android:key="udfps_animation"
            android:title="@string/themes_udfps_animation_title"
            android:summary="@string/themes_udfps_animation_summary"
            android:fragment="org.expressiveos.settings.fragments.themes.UdfpsAnimation" />

    </PreferenceCategory>

    <PreferenceCategory
        android:key="video_wallpaper_category"
        android:title="@string/video_wallpaper_category">

        <org.expressiveos.settings.preferences.SystemSettingSwitchPreference
            android:key="wallpaper_zoom_enabled"
            android:title="@string/wallpaper_zoom_title"
            android:summary="@string/wallpaper_zoom_summary"
            android:defaultValue="true" />

        <org.expressiveos.settings.preferences.SystemSettingPrimarySwitchPreference
            android:key="lock_glymps_enabled"
            android:title="@string/lock_glymps_title"
            android:summary="@string/lock_glymps_enable_summary"
            android:fragment="org.expressiveos.settings.fragments.themes.LockGlympsSettings"
            android:defaultValue="false" />

        <Preference
            android:key="wallpaper_settings"
            android:title="@string/wallpaper_styles_title"
            android:summary="@string/wallpaper_settings_summary"
            android:fragment="org.expressiveos.settings.fragments.themes.Wallpaper" />

    </PreferenceCategory>

    <PreferenceCategory
        android:key="themes_audio_category"
        android:title="@string/themes_audio_category">

        <!-- Lock sound -->
        <org.expressiveos.settings.preferences.SoundPickerPreference
            android:key="lock_sound"
            android:title="@string/themes_lock_sound_title"
            android:defaultValue="/product/media/audio/ui/Lock.ogg" />

        <!-- Unlock sound -->
        <org.expressiveos.settings.preferences.SoundPickerPreference
            android:key="unlock_sound"
            android:title="@string/themes_unlock_sound_title"
            android:defaultValue="/product/media/audio/ui/Unlock.ogg" />

    </PreferenceCategory>

</PreferenceScreen>
