<com.android.settingslib.widget.DrawableStateLinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="?android:attr/listPreferredItemPaddingStart"
    android:paddingEnd="?android:attr/listPreferredItemPaddingEnd"
    android:background="@drawable/settingslib_round_background_stateful"
    android:clipToPadding="false"
    android:clipChildren="false"
    android:baselineAligned="false">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingTop="18dp"
        android:paddingBottom="18dp">

        <TextView
            android:id="@+id/preview_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/lock_glymps_preview_title"
            android:textAppearance="@style/TextAppearance.SettingsLib.TitleMedium.Emphasized"
            android:textColor="?android:attr/textColorPrimary"
            android:layout_marginBottom="4dp" />

        <TextView
            android:id="@+id/preview_summary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/lock_glymps_preview_summary"
            android:textAppearance="@style/TextAppearance.SettingsLib.BodyMedium"
            android:textColor="?android:attr/textColorSecondary"
            android:layout_marginBottom="16dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:weightSum="2"
            android:layout_marginBottom="18dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:paddingEnd="6dp">

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/lock_wallpaper_card"
                    android:layout_width="match_parent"
                    android:layout_height="204dp"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="0dp"
                    app:strokeWidth="1dp"
                    app:strokeColor="@color/settingslib_materialColorOutlineVariant">

                    <ImageView
                        android:id="@+id/lock_wallpaper_preview"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="centerCrop"
                        android:contentDescription="@string/lock_glymps_lock_preview_desc" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="64dp"
                        android:layout_gravity="bottom"
                        android:background="@drawable/preview_gradient" />

                    <TextView
                        android:id="@+id/lock_wallpaper_label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="bottom|start"
                        android:layout_margin="12dp"
                        android:text="@string/lock_glymps_lock_screen"
                        android:textAppearance="@style/TextAppearance.SettingsLib.LabelLarge.Emphasized"
                        android:textColor="@android:color/white"
                        android:drawableStart="@drawable/ic_lock"
                        android:drawablePadding="6dp"
                        android:drawableTint="@android:color/white"
                        android:maxLines="1"
                        android:ellipsize="end" />

                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:paddingStart="6dp">

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/home_wallpaper_card"
                    android:layout_width="match_parent"
                    android:layout_height="204dp"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="0dp"
                    app:strokeWidth="1dp"
                    app:strokeColor="@color/settingslib_materialColorOutlineVariant">

                    <ImageView
                        android:id="@+id/home_wallpaper_preview"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="centerCrop"
                        android:contentDescription="@string/lock_glymps_home_preview_desc" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="64dp"
                        android:layout_gravity="bottom"
                        android:background="@drawable/preview_gradient" />

                    <TextView
                        android:id="@+id/home_wallpaper_label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="bottom|start"
                        android:layout_margin="12dp"
                        android:text="@string/lock_glymps_home_screen"
                        android:textAppearance="@style/TextAppearance.SettingsLib.LabelLarge.Emphasized"
                        android:textColor="@android:color/white"
                        android:drawableStart="@drawable/ic_home"
                        android:drawablePadding="6dp"
                        android:drawableTint="@android:color/white"
                        android:maxLines="1"
                        android:ellipsize="end" />

                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>

        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/apply_now_button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:text="@string/lock_glymps_apply_now"
            android:textAppearance="@style/TextAppearance.SettingsLib.LabelLarge.Emphasized"
            android:textColor="@color/settingslib_materialColorOnPrimary"
            android:backgroundTint="@color/settingslib_materialColorPrimary"
            app:icon="@drawable/ic_refresh"
            app:iconGravity="textStart"
            app:iconTint="@color/settingslib_materialColorOnPrimary"
            app:cornerRadius="1000dp"
            style="@style/Widget.Material3.Button" />

    </LinearLayout>

</com.android.settingslib.widget.DrawableStateLinearLayout>
