<com.android.settingslib.widget.DrawableStateLinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:gravity="center_vertical"
    android:paddingStart="?android:attr/listPreferredItemPaddingStart"
    android:paddingEnd="?android:attr/listPreferredItemPaddingEnd"
    android:background="@drawable/settingslib_round_background_stateful"
    android:clipToPadding="false"
    android:clipChildren="false"
    android:baselineAligned="false"
    android:filterTouchesWhenObscured="false">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingTop="@dimen/settingslib_expressive_space_small1"
        android:paddingBottom="12dp"
        android:clipChildren="false"
        android:clipToPadding="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:baselineAligned="false">

            <include layout="@layout/settingslib_expressive_preference_icon_frame" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:paddingEnd="8dp">

                <TextView
                    android:id="@android:id/title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="start"
                    android:textAlignment="viewStart"
                    android:textAppearance="?android:attr/textAppearanceListItem"
                    android:maxLines="2"
                    android:ellipsize="end" />

                <TextView
                    android:id="@android:id/summary"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="start"
                    android:layout_marginTop="2dp"
                    android:textAlignment="viewStart"
                    android:textAppearance="?android:attr/textAppearanceListItemSecondary"
                    android:textColor="?android:attr/textColorSecondary"
                    android:maxLines="6"
                    android:visibility="gone" />
            </LinearLayout>

            <FrameLayout
                android:id="@+id/custom_seekbar_reset_button"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="@string/color_picker_reset"
                android:visibility="gone">

                <FrameLayout
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_gravity="center"
                    android:background="@drawable/bg_custom_seekbar_reset_pill">

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_custom_seekbar_reset"
                        android:tint="@color/settingslib_materialColorOnSurfaceVariant"
                        android:importantForAccessibility="no" />
                </FrameLayout>
            </FrameLayout>

            <TextView
                android:id="@+id/custom_seekbar_value_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_custom_seekbar_value_pill"
                android:paddingHorizontal="12dp"
                android:paddingVertical="5dp"
                android:gravity="center"
                android:singleLine="true"
                android:fontFeatureSettings="tnum"
                android:textAppearance="@style/TextAppearance.SettingsLib.LabelLarge.Emphasized"
                android:textColor="@color/settingslib_materialColorOnSecondaryContainer" />
        </LinearLayout>

        <include
            layout="@layout/settingslib_expressive_layout_slider"
            android:id="@+id/slider_frame"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp" />

        <LinearLayout
            android:id="@+id/custom_seekbar_label_frame"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:visibility="gone">

            <TextView
                android:id="@android:id/text1"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textAppearance="?android:attr/textAppearanceSmall"
                android:textColor="?android:attr/textColorSecondary"
                android:textAlignment="viewStart" />

            <TextView
                android:id="@android:id/text2"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textAppearance="?android:attr/textAppearanceSmall"
                android:textColor="?android:attr/textColorSecondary"
                android:textAlignment="viewEnd" />
        </LinearLayout>
    </LinearLayout>
</com.android.settingslib.widget.DrawableStateLinearLayout>
