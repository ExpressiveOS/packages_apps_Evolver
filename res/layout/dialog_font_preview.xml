<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_studio_section_card"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:id="@+id/preview_headline"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/font_preview_sample_headline"
            android:textAppearance="@style/TextAppearance.SettingsLib.TitleLarge"
            android:textColor="@color/settingslib_materialColorOnSurface"
            android:textSize="24sp" />

        <TextView
            android:id="@+id/preview_digits"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="12dp"
            android:fontFeatureSettings="tnum"
            android:text="@string/font_preview_sample_digits"
            android:textAppearance="@style/TextAppearance.SettingsLib.BodyMedium"
            android:textColor="@color/settingslib_materialColorOnSurfaceVariant"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/preview_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/font_preview_quote"
            android:textAppearance="@style/TextAppearance.SettingsLib.BodyLarge"
            android:textColor="@color/settingslib_materialColorOnSurface"
            android:textSize="18sp"
            android:lineSpacingMultiplier="1.3" />

    </LinearLayout>

</LinearLayout>
